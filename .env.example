# Application
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info

# PostgreSQL (native/local run)
DB_DSN="host=localhost user=fff password=fff dbname=fff port=5432 sslmode=disable TimeZone=UTC"
MIGRATE_ON_START=true

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# MQTT (prefix and topics follow the project document: free-flame-forest)
MQTT_BROKER=tcp://localhost:1883
MQTT_CLIENT_ID=
MQTT_USERNAME=backend
MQTT_PASSWORD=change-me-backend
MQTT_QOS=1
AUTO_REGISTER_DEVICES=true

# JWT (minimum 24 characters)
JWT_SECRET=change-me-jwt-secret-please-use-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Seed data
SEED_ADMIN_EMAIL=admin@fff.local
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME="Administrator"
SEED_DEVICE_ID=DEVICE-123
SEED_DEVICE_NAME="Simulator Device"

# Risk thresholds
THRESHOLD_TEMPERATURE_HIGH_C=40
THRESHOLD_SOIL_DRY_PCT=30
THRESHOLD_SMOKE_LEVEL=300
EVENT_COOLDOWN=5m
FIRE_EVENT_COOLDOWN=1m

# Automatic pump
AUTO_PUMP_ENABLED=true
AUTO_PUMP_DURATION=30s
AUTO_PUMP_COOLDOWN=5m
AUTO_PUMP_MAX_DURATION=300s

# Device health and retention
DEVICE_OFFLINE_AFTER=30s
COMMAND_TIMEOUT=60s
TELEMETRY_RETENTION_DAYS=90

# HTTP / WebSocket
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
WS_ALLOWED_ORIGIN=*
LOGIN_RATE_LIMIT_PER_MIN=10

# Firebase Cloud Messaging (leave empty to disable push)
FCM_CREDENTIALS_FILE=
FCM_PROJECT_ID=
FCM_MIN_SEVERITY=critical

# Docker Compose variables
POSTGRES_PASSWORD=fff
MQTT_BACKEND_PASSWORD=change-me-backend
MQTT_DEVICE_USERNAME=DEVICE-123
MQTT_DEVICE_PASSWORD=device123
