# Application
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info

# PostgreSQL (native/local run)
DB_DSN="host=localhost user=fff password=fff dbname=fff port=5432 sslmode=disable TimeZone=UTC"
# Run `make migrate` before starting the API/worker. Set to true only for
# throwaway local databases where startup migrations are convenient.
MIGRATE_ON_START=false

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# MQTT (website virtual device is the source of truth for topic prefix)
MQTT_BROKER=tcp://localhost:1883
MQTT_CLIENT_ID=
MQTT_USERNAME=backend
MQTT_PASSWORD=change-me-backend
MQTT_QOS=1
MQTT_TOPIC_PREFIX=fire-free-forest
AUTO_REGISTER_DEVICES=true

# JWT (minimum 24 characters)
JWT_SECRET=change-me-jwt-secret-please-use-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Seed data
SEED_ADMIN_EMAIL=admin@fff.local
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME="Administrator"
SEED_DEVICE_ID=FFF-VIRTUAL-DEVICE
SEED_DEVICE_NAME="Simulator Device"

# Risk thresholds
THRESHOLD_TEMPERATURE_HIGH_C=40
THRESHOLD_SOIL_DRY_ADC=300
THRESHOLD_SMOKE_LEVEL=500
THRESHOLD_BATTERY_LOW_PERCENT=20
EVENT_COOLDOWN=5m
FIRE_EVENT_COOLDOWN=1m

# Automatic pump
AUTO_PUMP_ENABLED=false
AUTO_PUMP_DURATION=30s
AUTO_PUMP_COOLDOWN=5m
AUTO_PUMP_MAX_DURATION=300s

# Device health and retention
DEVICE_OFFLINE_AFTER=30s
COMMAND_TIMEOUT=60s
TELEMETRY_RETENTION_DAYS=90

# Telemetry snapshot refresh before creating an event
TELEMETRY_REFRESH_TIMEOUT=5s
TELEMETRY_REFRESH_THROTTLE=30s

# HTTP / WebSocket
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
WS_ALLOWED_ORIGIN=*
LOGIN_RATE_LIMIT_PER_MIN=10

# Reverse geocoding (backend proxy for mobile and web dashboard)
GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
GEOCODE_USER_AGENT=FireFreeForest/1.0
GEOCODE_CACHE_TTL=720h

# Firebase Cloud Messaging (leave empty to disable push)
FCM_CREDENTIALS_FILE=
FCM_PROJECT_ID=
FCM_MIN_SEVERITY=error
FCM_EVENT_TYPES=FIRE_DETECTED,SMOKE_DETECTED,TEMPERATURE_HIGH,SOIL_DRY,DEVICE_OFFLINE,SENSOR_ERROR,LOW_BATTERY

# MCP (Model Context Protocol)
# Read-only. HTTP /mcp is enabled automatically when MCP_API_KEY is non-empty;
# clients send it as "Authorization: Bearer <MCP_API_KEY>".
MCP_API_KEY=
MCP_RATE_LIMIT_PER_MIN=120

# Assistant (Mastra agent proxy). Leave MASTRA_URL empty to disable the routes.
# MASTRA_URL is internal: never expose Mastra directly to the browser.
MASTRA_URL=
ASSISTANT_RATE_LIMIT_PER_MIN=20
ASSISTANT_MAX_CONCURRENT_STREAMS=2

# Docker Compose variables
POSTGRES_PASSWORD=fff
MQTT_BACKEND_PASSWORD=change-me-backend
# Shared by every device. Use a random username and a strong password; never use defaults.
MQTT_DEVICE_USERNAME=replace-with-random-device-username
MQTT_DEVICE_PASSWORD=replace-with-strong-device-password
