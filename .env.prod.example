# Copy this file to .env on the VPS. Never commit the real .env file.
APP_ENV=production
HTTP_ADDR=:8080
LOG_LEVEL=info
MIGRATE_ON_START=true

# Database
POSTGRES_PASSWORD=replace-with-a-strong-password
DB_DSN="host=postgres user=fff password=replace-with-a-strong-password dbname=fff port=5432 sslmode=disable TimeZone=UTC"

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# MQTT
MQTT_BROKER=tcp://mosquitto:1883
MQTT_CLIENT_ID=
MQTT_USERNAME=backend
# Must match MQTT_BACKEND_PASSWORD below.
MQTT_PASSWORD=replace-with-a-strong-mqtt-password
MQTT_QOS=1
MQTT_TOPIC_PREFIX=fire-free-forest
AUTO_REGISTER_DEVICES=true

# JWT
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Seed data
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_ADMIN_NAME="Administrator"
SEED_DEVICE_ID=FFF-VIRTUAL-DEVICE
SEED_DEVICE_NAME="Simulator Device"

# Risk thresholds
THRESHOLD_TEMPERATURE_HIGH_C=40
THRESHOLD_SOIL_DRY_ADC=300
THRESHOLD_SMOKE_LEVEL=500
EVENT_COOLDOWN=5m
FIRE_EVENT_COOLDOWN=1m

# Automatic pump
AUTO_PUMP_ENABLED=false
AUTO_PUMP_DURATION=30s
AUTO_PUMP_COOLDOWN=5m
AUTO_PUMP_MAX_DURATION=300s

# Device health and retention
DEVICE_OFFLINE_AFTER=30s
COMMAND_TIMEOUT=60s
TELEMETRY_RETENTION_DAYS=90

# HTTP / WebSocket
CORS_ORIGINS=https://virtual-device-six.vercel.app
WS_ALLOWED_ORIGIN=https://virtual-device-six.vercel.app
LOGIN_RATE_LIMIT_PER_MIN=10

# Firebase Cloud Messaging
FCM_CREDENTIALS_FILE=/app/secrets/service-account.json
FCM_PROJECT_ID=
FCM_MIN_SEVERITY=error
FCM_EVENT_TYPES=FIRE_DETECTED,SMOKE_DETECTED,TEMPERATURE_HIGH,SOIL_DRY,DEVICE_OFFLINE,SENSOR_ERROR

# Docker Compose ports
# Keep backend and MQTT ports on loopback; Caddy is the only public entrypoint.
API_BIND_IP=127.0.0.1
MQTT_BIND_IP=127.0.0.1
MQTT_WS_BIND_IP=127.0.0.1

# Caddy
API_DOMAIN=api.example.com
MQTT_DOMAIN=mqtt.example.com
ACME_EMAIL=admin@example.com

# Device credentials for the website virtual device
MQTT_BACKEND_PASSWORD=replace-with-a-strong-mqtt-password
MQTT_DEVICE_USERNAME=FFF-VIRTUAL-DEVICE
MQTT_DEVICE_PASSWORD=replace-with-a-strong-device-password
